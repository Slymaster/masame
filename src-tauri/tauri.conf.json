{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Masame",
  "mainBinaryName": "masame",
  "version": "0.2.0",
  "identifier": "com.sylvainrey.masame",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && node scripts/third-party-licenses.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Masame",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#ECE4D6"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://online-go.com wss://online-go.com; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "category": "BoardGame",
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources/katago/analysis.cfg",
      "resources/licenses/"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "French"
        ],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1QkMzOEJCMUMyNjczQjcKUldTM2N5WWN1emk4bGVsV2djcGl0OEVxSjFhYkZ0V3RuSWhldXZKdkxHRnl0L2JVdzN4TWtIdXUK",
      "endpoints": [
        "https://github.com/Slymaster/masame/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
